module

public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import Mathlib.RingTheory.Ideal.Quotient.Nilpotent

/-!
# Reduced unions of coordinate hyperplanes

The ideal generated by a product of distinct variables is radical over a factorial domain.
Thus a union of distinct coordinate hyperplanes is reduced. This is the algebraic model
for a normal crossings boundary, including the empty boundary given by the empty product.
-/

public section

namespace MvPolynomial

variable {R σ : Type*} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R]

/-- The union of finitely many distinct coordinate hyperplanes is reduced. -/
theorem isRadical_span_prod_X (s : Finset σ) :
    (Ideal.span {∏ i ∈ s, (X i : MvPolynomial σ R)}).IsRadical := by
  classical
  apply isRadical_iff_span_singleton.mp
  apply Squarefree.isRadical
  refine Finset.squarefree_prod_of_pairwise_isCoprime ?_
    (fun i _ ↦ (prime_X (i := i)).squarefree)
  intro i _ j _ hij
  exact (prime_X (i := i)).irreducible.isRelPrime_iff_not_dvd.mpr (by simpa using hij)

end MvPolynomial
