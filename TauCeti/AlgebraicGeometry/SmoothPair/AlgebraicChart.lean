public import TauCeti.RingTheory.MvPolynomial.CoordinateHyperplanes
public import TauCeti.RingTheory.Smooth.Radical
public import TauCeti.RingTheory.Flat.NonZeroDivisors
public import Mathlib.RingTheory.RingHom.Etale

/-!
# Algebraic normal crossings charts

A relative normal crossings chart presents an ideal as the pullback of a product of
distinct coordinates under an étale map from affine space. Its generator is a
nonzerodivisor and its ideal is radical, so it defines a reduced effective Cartier
boundary. No valuation, completeness, or characteristic assumption is imposed on the field.

The identity charts give the coordinate models, and charts can be transported along
étale ring maps. The zero ideal has no chart on a nonzero ring, while the unit ideal
is the empty-boundary model. These charts retain the scalar map for use on affine
opens of smooth pairs and in analytification.

## References

Diao–Lan–Liu–Zhu, *Logarithmic adic spaces: some foundational results*, Example 2.3.17,
for the coordinate description of a normal crossings boundary.
-/

public section

namespace TauCeti.SmoothPair

open MvPolynomial

variable (K : Type*) [Field K]

/-- An étale coordinate chart over `K` in which the boundary ideal is generated by
the product of the first `r` distinct coordinates. Zero boundary coordinates give
the unit ideal, representing an empty boundary. -/
structure AlgebraicChart {R : Type*} [CommRing R] (σ : K →+* R) (I : Ideal R) where
  /-- The dimension of the affine coordinate space. -/
  n : ℕ
  /-- The number of boundary coordinates. -/
  r : ℕ
  /-- The boundary coordinates are among the affine coordinates. -/
  le : r ≤ n
  /-- The étale coordinate map. -/
  coord : MvPolynomial (Fin n) K →+* R
  /-- The chart respects the specified scalar map. -/
  coord_comp_C : coord.comp MvPolynomial.C = σ
  /-- The coordinate map is étale. -/
  etale : coord.Etale
  /-- The boundary is the coordinate-product ideal, with its scheme structure. -/
  ideal_eq : I = Ideal.span {coord (∏ i : Fin r, X (Fin.castLE le i))}

namespace AlgebraicChart

variable {K} {R S : Type*} [CommRing R] [CommRing S]
  {σ : K →+* R} {I : Ideal R}

/-- The displayed local equation of the boundary. -/
noncomputable def generator (c : AlgebraicChart K σ I) : R :=
  c.coord (∏ i : Fin c.r, X (Fin.castLE c.le i))

/-- The generator is the product of the pulled-back boundary coordinates. -/
theorem generator_def (c : AlgebraicChart K σ I) :
    c.generator = ∏ i : Fin c.r, c.coord (X (Fin.castLE c.le i)) := by
  simp [generator]

/-- The boundary ideal is generated by its displayed equation. -/
theorem ideal_eq_span_generator (c : AlgebraicChart K σ I) :
    I = Ideal.span {c.generator} := c.ideal_eq

/-- Membership in the boundary ideal is divisibility by its equation. -/
theorem mem_ideal_iff (c : AlgebraicChart K σ I) (x : R) :
    x ∈ I ↔ c.generator ∣ x := by
  simp only [c.ideal_eq_span_generator, Ideal.mem_span_singleton]

/-- The boundary equation is a nonzerodivisor, including in the zero ring. -/
theorem generator_mem_nonZeroDivisors (c : AlgebraicChart K σ I) :
    c.generator ∈ nonZeroDivisors R := by
  let _ := c.coord.toAlgebra
  have _ : Algebra.Etale (MvPolynomial (Fin c.n) K) R := c.etale.toAlgebra
  apply Module.Flat.algebraMap_mem_nonZeroDivisors
  exact isRegular_iff_mem_nonZeroDivisors.mp
    (IsRegular.prod fun _ _ ↦ MvPolynomial.isRegular_X)

/-- A boundary presented by an étale coordinate chart is reduced. -/
theorem isRadical (c : AlgebraicChart K σ I) : I.IsRadical := by
  classical
  have hprod : (Ideal.span {∏ i : Fin c.r,
      (X (Fin.castLE c.le i) : MvPolynomial (Fin c.n) K)}).IsRadical := by
    simpa only [Finset.prod_image (Fin.castLE_injective c.le).injOn] using
      (MvPolynomial.isRadical_span_prod_X (R := K)
        (Finset.univ.image (Fin.castLE c.le)))
  rw [c.ideal_eq]
  simpa only [Ideal.map_span, Set.image_singleton] using
    ((RingHom.etale_iff_formallyUnramified_and_smooth c.coord).mp c.etale).2.isRadical_map hprod

/-- The unit ideal is precisely the case where the displayed boundary equation is a unit. -/
theorem ideal_eq_top_iff (c : AlgebraicChart K σ I) : I = ⊤ ↔ IsUnit c.generator := by
  simp only [c.ideal_eq_span_generator, Ideal.span_singleton_eq_top]

/-- With no boundary coordinates the chart has empty boundary. -/
theorem ideal_eq_top_of_r_eq_zero (c : AlgebraicChart K σ I) (hr : c.r = 0) : I = ⊤ := by
  apply c.ideal_eq_top_iff.mpr
  simp [generator, hr]

/-- Pull back a chart along an étale ring map, extending the boundary ideal without
 taking its radical. The constructor is transparent so that its dependent coordinate
 type is the same polynomial ring as that of the original chart. -/
@[expose]
noncomputable def map (c : AlgebraicChart K σ I) (f : R →+* S) (hf : f.Etale) :
    AlgebraicChart K (f.comp σ) (I.map f) where
  n := c.n
  r := c.r
  le := c.le
  coord := f.comp c.coord
  coord_comp_C := by rw [RingHom.comp_assoc, c.coord_comp_C]
  etale := by
    have hc := c.etale
    algebraize [c.coord, f, f.comp c.coord]
    let _ : IsScalarTower (MvPolynomial (Fin c.n) K) R S :=
      IsScalarTower.of_algebraMap_eq' rfl
    exact Algebra.Etale.comp (MvPolynomial (Fin c.n) K) R S
  ideal_eq := by simp only [c.ideal_eq, Ideal.map_span, Set.image_singleton, RingHom.comp_apply]

@[simp]
theorem map_n (c : AlgebraicChart K σ I) (f : R →+* S) (hf : f.Etale) :
    (c.map f hf).n = c.n := (rfl)

@[simp]
theorem map_r (c : AlgebraicChart K σ I) (f : R →+* S) (hf : f.Etale) :
    (c.map f hf).r = c.r := (rfl)

@[simp]
theorem map_coord_apply (c : AlgebraicChart K σ I) (f : R →+* S) (hf : f.Etale)
    (p : MvPolynomial (Fin c.n) K) : (c.map f hf).coord p = f (c.coord p) := (rfl)

@[simp]
theorem map_generator (c : AlgebraicChart K σ I) (f : R →+* S) (hf : f.Etale) :
    (c.map f hf).generator = f c.generator := (rfl)

/-- On a nonzero ring the whole space cannot be a normal crossings boundary. -/
theorem no_full_boundary [Nontrivial R] (σ : K →+* R) :
    IsEmpty (AlgebraicChart K σ ⊥) := by
  refine ⟨fun c ↦ ?_⟩
  have hzero : c.generator = 0 := by
    simpa using (c.mem_ideal_iff c.generator).mpr dvd_rfl
  exact nonZeroDivisors.ne_zero c.generator_mem_nonZeroDivisors hzero

/-- A doubled coordinate hyperplane cannot admit a normal crossings chart, in any
characteristic and for any choice of scalar map. -/
theorem no_doubled_coordinate {ι : Type*} (i : ι) (σ : K →+* MvPolynomial ι K) :
    IsEmpty (AlgebraicChart K σ (Ideal.span {(X i : MvPolynomial ι K) ^ 2})) := by
  refine ⟨fun c ↦ ?_⟩
  have hx : (X i : MvPolynomial ι K) ∈ Ideal.span {(X i : MvPolynomial ι K) ^ 2} :=
    c.isRadical (Ideal.mem_radical_iff.mpr ⟨2, Ideal.subset_span (Set.mem_singleton _)⟩)
  have hsq : (X i : MvPolynomial ι K) * X i ∣ X i := by
    simpa only [pow_two] using Ideal.mem_span_singleton.mp hx
  exact (prime_X (i := i) (R := K)).not_isUnit ((prime_X (i := i)).squarefree _ hsq)

end AlgebraicChart

/-- The identity chart with the first `r` coordinate hyperplanes as boundary.
The constructor is transparent so that its coordinate map accepts polynomials in `Fin n`. -/
@[expose]
noncomputable def modelAlgebraicChart (n r : ℕ) (hr : r ≤ n) :
    AlgebraicChart K (C : K →+* MvPolynomial (Fin n) K)
      (Ideal.span {∏ i : Fin r, X (Fin.castLE hr i)}) where
  n := n
  r := r
  le := hr
  coord := RingHom.id _
  coord_comp_C := rfl
  etale := RingHom.Etale.of_bijective Function.bijective_id
  ideal_eq := rfl

@[simp]
theorem modelAlgebraicChart_n (n r : ℕ) (hr : r ≤ n) :
    (modelAlgebraicChart K n r hr).n = n := (rfl)

@[simp]
theorem modelAlgebraicChart_r (n r : ℕ) (hr : r ≤ n) :
    (modelAlgebraicChart K n r hr).r = r := (rfl)

@[simp]
theorem modelAlgebraicChart_coord_apply (n r : ℕ) (hr : r ≤ n)
    (p : MvPolynomial (Fin n) K) : (modelAlgebraicChart K n r hr).coord p = p := (rfl)

@[simp]
theorem modelAlgebraicChart_generator (n r : ℕ) (hr : r ≤ n) :
    (modelAlgebraicChart K n r hr).generator =
      ∏ i : Fin r, (X (Fin.castLE hr i) : MvPolynomial (Fin n) K) := (rfl)

end TauCeti.SmoothPair
